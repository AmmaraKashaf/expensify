# Same Supabase DATABASE_URL used by the Express server
# Use port 6543 (transaction pooler) — psycopg2 is compatible via NullPool
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres

# OpenAI key for LangChain categorization and narrative generation
OPENAI_API_KEY=sk-...

# Shared secret between Express server and this AI service
# Express will send this in the X-Api-Key header when proxying requests
AI_SERVICE_KEY=change-me-to-a-long-random-string

# Comma-separated allowed CORS origins (set to Express origin in production)
ALLOWED_ORIGINS=http://localhost:3001,https://api.filtech.pk

PORT=8000
